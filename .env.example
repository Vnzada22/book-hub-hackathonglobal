# BookHub - Exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores reais

# ==========================================
# Banco de Dados (Supabase/PostgreSQL)
# ==========================================
DATABASE_URL=postgres://usuario:senha@host:porta/banco

# ==========================================
# Autenticação
# ==========================================
# Chave secreta para tokens de sessão e HMAC de códigos de e-mail
AUTH_TOKEN_SECRET=sua-chave-secreta-muito-longa-e-aleatoria

# URL base da aplicação (usada em callbacks OAuth e cookies)
# Desenvolvimento: http://localhost:3000
# Produção: https://seu-dominio.com
AUTH_BASE_URL=http://localhost:3000

# Origem permitida para CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# E-mail remetente (Resend)
AUTH_EMAIL_FROM=BookHub <onboarding@resend.dev>

# ==========================================
# Provedor de E-mail (Resend)
# ==========================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# OAuth - Google
# ==========================================
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# ==========================================
# OAuth - X (Twitter) com PKCE
# ==========================================
X_CLIENT_ID=seu-client-id
X_CLIENT_SECRET=seu-client-secret

# ==========================================
# IA - Google Gemini
# ==========================================
GEMINI_API_KEY=sua-chave-gemini

# Opcional: chave de Google Books para ampliar limites de consulta; somente no backend.
# GOOGLE_BOOKS_API_KEY=sua-chave-google-books

# Modelo opcional (padrão: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Configurações do Servidor
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# Supabase (se usar cliente direto)
# ==========================================
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=sua-chave-anon
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role (NÃO EXPOR NO FRONTEND)